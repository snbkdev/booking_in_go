{{template "base" .}}

{{define "title"}}Login · {{end}}

{{define "content"}}
    <section class="section">
        <div class="container">
            <div class="auth-card">
                <div class="text-center mb-4">
                    <span class="eyebrow">Staff area</span>
                    <h1 class="h3 mb-2">Sign in</h1>
                    <p class="text-muted mb-0">
                        Reservations, the calendar and guest details live behind this form.
                    </p>
                </div>

                <form method="post" action="/user/login" novalidate class="needs-validation">
                    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">

                    <div class="mb-3">
                        <label for="email" class="form-label">Email</label>
                        <input class="form-control {{with .Form.Errors.Get "email"}}is-invalid{{end}}"
                               id="email" name="email" type="email" autocomplete="username" required>
                        {{with .Form.Errors.Get "email"}}
                            <div class="text-danger small mt-1">{{.}}</div>
                        {{end}}
                        <div class="invalid-feedback">Please enter a valid email address.</div>
                    </div>

                    <div class="mb-4">
                        <label for="password" class="form-label">Password</label>
                        <input class="form-control {{with .Form.Errors.Get "password"}}is-invalid{{end}}"
                               id="password" name="password" type="password" autocomplete="current-password" required>
                        {{with .Form.Errors.Get "password"}}
                            <div class="text-danger small mt-1">{{.}}</div>
                        {{end}}
                        <div class="invalid-feedback">Please enter your password.</div>
                    </div>

                    <button type="submit" class="btn btn-brand btn-lg w-100">Sign in</button>
                </form>

                <p class="text-muted small text-center mb-0 mt-4">
                    Looking to book a room instead?
                    <a href="/search-availability">Check availability</a>.
                </p>
            </div>
        </div>
    </section>
{{end}}
