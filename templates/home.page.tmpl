{{template "base" .}}

{{define "title"}}Rooms by the sea · {{end}}

{{define "content"}}
    <div id="homeCarousel" class="carousel carousel-dark slide carousel-fade home-carousel">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#homeCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#homeCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#homeCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
        </div>
        <div class="carousel-inner">
            <div class="carousel-item active" data-bs-interval="7000">
                <img src="/static/images/house.jpg" class="d-block w-100" alt="The stone house at Fort Smyth">
                <div class="carousel-caption d-none d-md-block">
                    <h5>Built in 1876, restored in 2019</h5>
                    <p>Two guest rooms in a stone house above the harbour — never more than four guests at a time.</p>
                </div>
            </div>
            <div class="carousel-item" data-bs-interval="7000">
                <img src="/static/images/coffee.jpg" class="d-block w-100" alt="Breakfast served in the dining room">
                <div class="carousel-caption d-none d-md-block">
                    <h5>Breakfast at your own pace</h5>
                    <p>Fresh bread, local eggs and coffee from the roastery in town, served between 8:00 and 10:30.</p>
                </div>
            </div>
            <div class="carousel-item" data-bs-interval="7000">
                <img src="/static/images/laptop.webp" class="d-block w-100" alt="A quiet corner for working">
                <div class="carousel-caption d-none d-md-block">
                    <h5>Quiet enough to work from</h5>
                    <p>Fibre internet in every room, a desk by the window and no one to interrupt you.</p>
                </div>
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#homeCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#homeCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>

    <section class="section">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-7">
                    <span class="eyebrow">Welcome</span>
                    <h1>Fort Smyth Bed &amp; Breakfast</h1>
                    <div class="rule"></div>
                    <p class="lead-muted">
                        The house sits on the last piece of high ground before the water, where the old
                        coastal fort used to keep watch. Inside there are two guest rooms, wide floorboards
                        that creak in the right places, and a dining room where breakfast runs long because
                        nobody is in a hurry.
                    </p>
                    <p class="lead-muted">
                        We keep it small on purpose. One family or two couples at a time means you get the
                        porch, the fireplace and the view without sharing them with a tour bus. Bookings are
                        confirmed by email within a few hours, and we answer the phone ourselves.
                    </p>
                    <a href="/search-availability" class="btn btn-brand btn-lg mt-2">Check availability</a>
                    <a href="/about" class="btn btn-outline-brand btn-lg mt-2 ms-2">About the house</a>
                </div>
                <div class="col-lg-5">
                    <div class="row g-3 text-center">
                        <div class="col-6">
                            <div class="card-soft p-4">
                                <div class="fact-number">2</div>
                                <div class="fact-label">Guest rooms</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="card-soft p-4">
                                <div class="fact-number">1876</div>
                                <div class="fact-label">Year built</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="card-soft p-4">
                                <div class="fact-number">400m</div>
                                <div class="fact-label">To the beach</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="card-soft p-4">
                                <div class="fact-number">9.6</div>
                                <div class="fact-label">Guest rating</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="section section-soft">
        <div class="container">
            <div class="text-center mb-5">
                <span class="eyebrow">What's included</span>
                <h2>Every stay comes with</h2>
                <div class="rule rule-center"></div>
            </div>
            <div class="row g-4">
                <div class="col-md-6 col-lg-3">
                    <div class="card-soft feature-card">
                        <div class="feature-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4Z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>
                        </div>
                        <h3 class="h5">Full breakfast</h3>
                        <p class="text-muted mb-0">
                            Cooked to order between 8:00 and 10:30. Vegetarian, vegan and gluten-free
                            versions if you tell us the day before.
                        </p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="card-soft feature-card">
                        <div class="feature-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg>
                        </div>
                        <h3 class="h5">Fibre internet</h3>
                        <p class="text-muted mb-0">
                            300 Mbit in every room, a real desk and a chair you can sit in for a whole
                            working day.
                        </p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="card-soft feature-card">
                        <div class="feature-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        </div>
                        <h3 class="h5">Free cancellation</h3>
                        <p class="text-muted mb-0">
                            Cancel up to 48 hours before arrival at no charge. No prepayment when you book
                            through this site.
                        </p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="card-soft feature-card">
                        <div class="feature-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V8l7-5 7 5v13"/><path d="M10 21v-6h4v6"/></svg>
                        </div>
                        <h3 class="h5">Parking &amp; the porch</h3>
                        <p class="text-muted mb-0">
                            Off-street parking for two cars, a wood stove in the sitting room and the porch
                            for as long as the weather allows.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="section">
        <div class="container">
            <div class="text-center mb-5">
                <span class="eyebrow">Where you'll sleep</span>
                <h2>Our two rooms</h2>
                <div class="rule rule-center"></div>
            </div>
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="card-soft room-card">
                        <img src="/static/images/generals.jpg" alt="General's Quarters">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h3 class="h4 mb-0">General's Quarters</h3>
                                <span class="price-tag">$189<small>/night</small></span>
                            </div>
                            <p class="text-muted">
                                The corner room on the first floor: king bed, working fireplace and three
                                windows facing the water. Sleeps two.
                            </p>
                            <ul class="amenity-list mb-4">
                                <li>32 m² · king bed · sea view</li>
                                <li>Private bathroom with a claw-foot tub</li>
                                <li>Fireplace, desk, armchair by the window</li>
                            </ul>
                            <a href="/generals-quarters" class="btn btn-brand">See the room</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card-soft room-card">
                        <img src="/static/images/majors.jpg" alt="Major's Suite">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h3 class="h4 mb-0">Major's Suite</h3>
                                <span class="price-tag">$225<small>/night</small></span>
                            </div>
                            <p class="text-muted">
                                Two rooms under the roof — a bedroom and a sitting room with a sofa bed.
                                The best choice for a family. Sleeps up to four.
                            </p>
                            <ul class="amenity-list mb-4">
                                <li>46 m² · queen bed + sofa bed</li>
                                <li>Separate sitting room and kitchenette</li>
                                <li>Balcony over the garden</li>
                            </ul>
                            <a href="/majors-suite" class="btn btn-brand">See the room</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="section section-soft">
        <div class="container">
            <div class="row g-4 align-items-center">
                <div class="col-lg-7">
                    <span class="eyebrow">Guest book</span>
                    <h2>What people write when they leave</h2>
                    <div class="rule"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="card-soft p-4">
                                <p class="mb-3">
                                    “We came for two nights and moved our flight to stay a third. The
                                    breakfast alone was worth the drive.”
                                </p>
                                <div class="fact-label">Marie &amp; Tom · General's Quarters</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card-soft p-4">
                                <p class="mb-3">
                                    “Travelled with two kids and it never felt cramped. The suite has its own
                                    sitting room, which saved our evenings.”
                                </p>
                                <div class="fact-label">The Okonkwo family · Major's Suite</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="booking-aside">
                        <span class="eyebrow">Ready when you are</span>
                        <h3 class="h4">Check the calendar</h3>
                        <p class="mb-4">
                            Pick your arrival and departure dates and we'll show you which of the two rooms
                            is still free. No prepayment, confirmation by email.
                        </p>
                        <a href="/search-availability" class="btn btn-accent w-100">Make a reservation</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
{{end}}
