{{template "admin" .}}

{{define "css"}}
    <link href="https://cdn.jsdelivr.net/npm/simple-datatables@latest/dist/style.css" rel="stylesheet" type="text/css">
{{end}}

{{define "page-title"}}
    All New Reservations
{{end}}

{{define "content"}}
    {{$res := index .Data "reservations"}}

    <div class="col-12 grid-margin">
        <div class="fs-head">
            <div>
                <h2 class="fs-head__title">
                    New reservations
                    <span class="fs-count{{if not $res}} fs-count--muted{{end}}">{{len $res}}</span>
                </h2>
                <p class="fs-head__hint">
                    Bookings nobody has processed yet. Open a guest to check the details, correct a typo
                    or delete a cancelled stay — it leaves this list as soon as you mark it processed.
                </p>
            </div>
            <div class="fs-head__actions">
                <a href="/admin/reservations-all" class="fs-btn fs-btn--outline">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13M8 12h13M8 18h13"/><path d="M3 6h.01M3 12h.01M3 18h.01"/></svg>
                    All reservations
                </a>
                <a href="/admin/reservations-calendar" class="fs-btn fs-btn--navy">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                    Calendar
                </a>
            </div>
        </div>

        <div class="fs-panel fs-panel--flush">
            {{if $res}}
                <table class="fs-list" id="new-res">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Guest</th>
                            <th>Room</th>
                            <th>Arrival</th>
                            <th>Departure</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                    {{range $res}}
                        <tr>
                            <td class="fs-id">#{{.ID}}</td>
                            <td>
                                <a class="fs-guest" href="/admin/reservations/new/{{.ID}}/show">
                                    <span class="fs-avatar">{{if .LastName}}{{slice .LastName 0 1}}{{else}}?{{end}}</span>
                                    <span class="fs-guest__name">{{.LastName}}{{if .FirstName}}, {{.FirstName}}{{end}}</span>
                                </a>
                            </td>
                            <td>
                                <span class="fs-pill {{if eq .Room.RoomName "General's Quarters"}}fs-pill--blue{{else}}fs-pill--gold{{end}}">{{.Room.RoomName}}</span>
                            </td>
                            <td>
                                <span class="fs-dates">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                                    {{humanDate .StartDate}}
                                </span>
                            </td>
                            <td>
                                <span class="fs-dates">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
                                    {{humanDate .EndDate}}
                                </span>
                            </td>
                            <td><span class="fs-pill fs-pill--blue fs-pill--dot">Needs review</span></td>
                        </tr>
                    {{end}}
                    </tbody>
                </table>
            {{else}}
                <div class="fs-empty">
                    <div class="fs-empty__icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
                    </div>
                    <div class="fs-empty__title">Nothing waiting for you</div>
                    <p>Every booking has been processed. New ones will show up here on their own.</p>
                </div>
            {{end}}
        </div>
    </div>
{{end}}

{{define "js"}}
    <script src="https://cdn.jsdelivr.net/npm/simple-datatables@latest" type="text/javascript"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function(){
            if (!document.getElementById("new-res")) {
                return;
            }
            const dataTable = new simpleDatatables.DataTable("#new-res", {
                select: 3, sort: "desc",
            })
        })
    </script>
{{end}}
