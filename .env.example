# Скопируйте этот файл в .env и подставьте свои значения
# cp .env.example .env

# Вариант 1: одна готовая строка подключения (имеет приоритет)
# DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/db_name?sslmode=disable

# Вариант 2: параметры по отдельности
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=db_name
DB_USER=postgres
DB_PASSWORD=password
DB_SSL_MODE=disable

# Почта (SMTP). Для локальной разработки — MailHog: brew install mailhog && mailhog
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
# none | starttls | ssltls
MAIL_ENCRYPTION=none
# адрес отправителя по умолчанию, если хендлер не задал свой
MAIL_FROM=stay@fortsmyth.ca
# папка с html-шаблонами писем
MAIL_TEMPLATES_DIR=./email-templates
# таймауты в секундах
MAIL_CONNECT_TIMEOUT=10
MAIL_SEND_TIMEOUT=10
